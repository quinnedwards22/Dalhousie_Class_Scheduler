VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key_here
VITE_PUBLIC_POSTHOG_KEY=your_posthog_key_here
# PostHog traffic goes through the /relay-dp rewrite (vercel.json), so no host is needed.
# Optional, build-time only: upload source maps to PostHog error tracking.
# POSTHOG_PERSONAL_API_KEY=phx_...  (scopes: error tracking write, organization read)
# POSTHOG_PROJECT_ID=347755
